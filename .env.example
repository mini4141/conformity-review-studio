# API
PORT=8787
TABLE_NAME=crs-table
DDB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-southeast-2
# local stand-ins for DynamoDB Local only (never real credentials)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DOCS_DIR=.local/docs
# DOCS_BUCKET=            # set in cloud (S3 documents bucket)
LLM_PROVIDER=rules        # rules | bedrock
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_CALLS=40
# Web
# VITE_API_BASE defaults to /api (leave unset; a leading slash gets path-mangled by Git Bash)
